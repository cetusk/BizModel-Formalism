# LaTeX の中間ファイル
*.aux
*.log
*.out
*.toc
*.lg
*.tmp
*.xref
*.idv
*.4ct
*.4tc
*.dvi
*.dlog
*.fls
*.fdb_latexmk

# ビルド成果物（GitHub Actions が生成する）
src/book.pdf
src/build/
docs/book/
docs/book.pdf
docs/index.html
docs/.nojekyll

# make4ht を src/ から直接叩くと（-d 指定とは別に）カレントにも
# 変換結果一式を残す。ローカル検証で src/ 直下に出た分の掃除用
src/book.css
src/book*.html

# データの生成物（data/scripts/parse.py などで再生成できる）
data/derived/
data/raw/chusho/extracted/*
!data/raw/chusho/extracted/README.md

# 取得途中の素材（手貼りのテキストなど。整形後に raw/ へ移す）
data/_tmp/

# 個社データの収集物。解析には使うが、集合そのものは再配布しない。
# 再取得の手順は data/raw/jinzai/search/README.md に書いてある。
# 残すのは許可番号の一覧（permits.tsv）だけで、届出の値は含めない。
data/raw/jinzai/detail/
data/raw/jinzai/henreikin/
data/raw/jinzai/henreikin_web/
data/raw/jinzai/search/html/
data/raw/jinzai/search/*.txt
data/raw/jinzai/*.py
# 同じデータの旧複製（data/raw/jinzai/*.py と同一。md5 一致）
data/scripts/jinzai_care.py
data/scripts/jinzai_doctor.py
data/scripts/jinzai_hoiku.py
data/scripts/jinzai_nurse.py
src/analysis/jinzai_care.py
src/analysis/jinzai_doctor.py
src/analysis/jinzai_hoiku.py
src/analysis/jinzai_nurse.py

# セッション固有のロック（Claude Code が作る）
.claude/*.lock

# 分析スクリプトが出す中間の結果
data/scripts/*.json

__pycache__/
*.pyc
claude_sandbox.bat

# 検討・実装記録（ローカルのみで管理するメモ）
docs/IMPL.md
