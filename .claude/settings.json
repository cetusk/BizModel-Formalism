{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(lualatex:*)",
      "Bash(make4ht:*)",
      "Bash(dvisvgm:*)",
      "Bash(pdftotext:*)",
      "Bash(pdftoppm:*)",
      "Bash(pdfinfo:*)",
      "Bash(mutool:*)",
      "Bash(python3:*)",
      "Bash(bash:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(pip:*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*token*)",
      "Read(./**/*secret*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "env": {
    "TEXMFHOME": "${HOME}/texmf",
    "LUAINPUTS": "${HOME}/texmf/scripts/lua/make4ht//:",
    "TEXINPUTS": "${HOME}/texmf/scripts/lua/make4ht//:"
  },
  "outputStyle": "default"
}
